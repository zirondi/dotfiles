#Hosts Defaults 
Host *
	# Keepalive
    TCPKeepAlive yes
    ServerAliveInterval 3
    ServerAliveCountMax 20
	
	# Multiplexing
    ControlMaster auto
    ControlPersist 10m
    ControlPath ~/.ssh/control-%h-%p-%r

	# Networking
    ConnectTimeout 10
    ConnectionAttempts 3
	Compression yes
    IPQoS lowdelay

	#Security
  	VisualHostKey yes
  	ForwardAgent no
	ExitOnForwardFailure yes
    StrictHostKeyChecking accept-new

