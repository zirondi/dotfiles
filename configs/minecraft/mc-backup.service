# Runs scripts/mc-backup.sh (installed as /usr/local/bin/mc-backup.sh).
[Unit]
Description=Restic backup of the Minecraft server
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/mc-backup/env
ExecStart=/usr/local/bin/mc-backup.sh
Nice=10
IOSchedulingClass=idle
