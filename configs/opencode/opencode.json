{
  "$schema": "https://opencode.ai/config.json",
  "skills": [
    "~/.agents/skills"
  ],
  "experimental": {
    "policies": [
      {
        "effect": "deny",
        "action": "provider.use",
        "resource": "*"
      },
      {
        "effect": "allow",
        "action": "provider.use",
        "resource": "ollama-local"
      }
    ]
  },
  "provider": {
    "ollama-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Local (M1)",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "apiKey": "local",
        "headerTimeout": false,
        "chunkTimeout": 600000
      },
      "models": {
        "qwen3.5-64k": {
          "name": "Qwen 3.5 9B (64k)",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        },
        "deepseek-r1:14b": {
          "name": "deepseek-r1:14b",
          "reasoning": true
        },
        "deepseek-r1:8b": {
          "name": "deepseek-r1:8b",
          "reasoning": true
        },
        "deepseek-coder-v2": {
          "name": "deepseek-coder-v2"
        },
        "qwen2.5-coder:7b": {
          "name": "qwen2.5-coder:7b"
        },
        "llama3.1": {
          "name": "llama3.1"
        }
      }
    }
  },
  "model": "ollama-local/qwen3.5-64k",
  "small_model": "ollama-local/qwen3.5-64k",
  "compaction": {
    "auto": true,
    "reserved": 16000
  }
}
