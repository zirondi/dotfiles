{
  "global": {
    "ask_for_confirmation_before_quitting": true,
    "check_for_updates_on_startup": true,
    "show_in_menu_bar": true,
    "show_profile_name_in_menu_bar": false
  },
  "profiles": [
    {
      "name": "Default",
      "complex_modifications": {
        "rules": [
          {
            "description": "Caps Lock as Hyper key: tap = Escape, hold = Cmd+Ctrl (WM $mod, see configs/design/KEYMAP.md); Shift+Caps Lock = Caps Lock",
            "manipulators": [
              {
                "from": {
                  "key_code": "caps_lock",
                  "modifiers": {
                    "mandatory": [
                      "shift"
                    ],
                    "optional": [
                      "caps_lock"
                    ]
                  }
                },
                "to": [
                  {
                    "key_code": "caps_lock"
                  }
                ],
                "type": "basic"
              },
              {
                "from": {
                  "key_code": "caps_lock",
                  "modifiers": {
                    "optional": [
                      "any"
                    ]
                  }
                },
                "to": [
                  {
                    "key_code": "left_control",
                    "modifiers": [
                      "left_command"
                    ]
                  }
                ],
                "to_if_alone": [
                  {
                    "key_code": "escape"
                  }
                ],
                "type": "basic"
              }
            ]
          },
          {
            "description": "Cmd+Ctrl+P opens the password menu (scripts/rbw-menu) in a Kitty window",
            "manipulators": [
              {
                "from": {
                  "key_code": "p",
                  "modifiers": {
                    "mandatory": [
                      "command",
                      "control"
                    ]
                  }
                },
                "to": [
                  {
                    "shell_command": "open -na kitty --args --title rbw-menu -o remember_window_size=no -o initial_window_width=100c -o initial_window_height=24c -o confirm_os_window_close=0 zsh -lc 'rbw-menu || { echo; read -k1 \"?[rbw-menu falhou] tecle algo para fechar \" }'"
                  }
                ],
                "type": "basic"
              }
            ]
          }
        ]
      },
      "virtual_hid_keyboard": {
        "keyboard_type_v2": "ansi"
      },
      "selected": true
    }
  ]
}
