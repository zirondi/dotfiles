# Hosts Defaults 
Host *
	# UseKeychain only exists in Apple's OpenSSH; without this Linux hosts abort parsing
	IgnoreUnknown UseKeychain

	# Keepalive
    TCPKeepAlive yes
    ServerAliveInterval 3
    ServerAliveCountMax 20
	
	# Multiplexin
    ControlMaster auto
    ControlPersist 10m
    ControlPath ~/.ssh/control-%h-%p-%r

	# Networking
    ConnectTimeout 10
    ConnectionAttempts 3
	Compression yes
    IPQoS af21 cs1

	#Security
  	VisualHostKey yes
  	ForwardAgent no
	ExitOnForwardFailure yes
    StrictHostKeyChecking accept-new

	#macos
	UseKeychain yes
    AddKeysToAgent yes

Host hetzner helsinki
	User zirondi
	HostName 46.62.213.8
	Port 42721
	IdentityFile ~/.ssh/main
  	IdentitiesOnly yes

Host github
	User git
	HostName github.com
	Port 22
	# IdentityFile ~/.ssh/main
	IdentitiesOnly yes
	RequestTTY 	no
	UseKeychain yes
    AddKeysToAgent yes

# Kindle 7th Gen (zirondi-kindle7)
Host kindle
	HostName zirondi-kindle7.local
	User root
	IdentityFile ~/.ssh/kindle_rsa
	identitiesonly yes
	# Legacy support for older OpenSSH versions
    PubkeyAcceptedAlgorithms +ssh-rsa
    HostKeyAlgorithms +ssh-rsa

# Raspberry Pi 3b+ (NixOS)
Host rpi3
	User zirondi
	HostName rpi3.local
	Port 22
	IdentityFile ~/.ssh/main
  	IdentitiesOnly yes
	# Forcing ipv4
	AddressFamily inet

